# Produktion – nach .env.prod kopieren und Werte eintragen, dann:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Ohne PROXYSQL_HOST, PROXYSQL_PASSWORD und GUI_PASSWORD startet nichts.

TZ=Europe/Berlin

# Zusätzliche Container: sync = automatischer Abgleich, proxysql = ProxySQL selbst mitbetreiben
# COMPOSE_PROFILES=sync,proxysql

# Logs gehen an Syslog – leer = Syslog des Hosts (/dev/log), sonst z. B. tcp://logs.example.com:514
# SYSLOG_ADDRESS=

# --- GUI (lauscht nur lokal – davor einen Reverse-Proxy mit HTTPS) ---
GUI_BIND=127.0.0.1
GUI_PORT=8080
GUI_USER=admin
GUI_PASSWORD=
# Zweites Login nur zum Lesen, ohne SQL-Konsole (leer = aus)
GUI_READONLY_USER=readonly
GUI_READONLY_PASSWORD=
# GUI_READONLY=1        # auch der Admin darf nichts ändern

# --- ProxySQL-Admin-Interface ---
# Bestehendes ProxySQL: Host/IP und ein Admin-Benutzer, der sich remote anmelden darf (nicht "admin").
# Mit Profil proxysql: PROXYSQL_HOST=proxysql, Benutzer radmin – das Passwort wird beim ersten Start gesetzt.
PROXYSQL_HOST=
PROXYSQL_PORT=6032
PROXYSQL_USER=radmin
PROXYSQL_PASSWORD=

# --- Backend (MariaDB/MySQL) für Kontenabgleich und Cluster-Erkennung (leer = aus) ---
# Am einfachsten: GRANT ALL PRIVILEGES ON *.* TO 'gui_admin'@'%' WITH GRANT OPTION (siehe README).
BACKEND_HOST=
BACKEND_PORT=3306
BACKEND_USER=gui_admin
BACKEND_PASSWORD=

# --- Automatischer Abgleich (nur mit Profil sync) ---
# users = fehlende Konten übernehmen, passwords = Passwörter angleichen, cluster = neue Knoten aufnehmen
AUTO_SYNC=
SYNC_INTERVAL=60
# Hostgroup für übernommene Konten (leer = Writer-Hostgroup des Backends)
SYNC_HOSTGROUP=

# --- Nur mit Profil proxysql (erster Start: Primary = BACKEND_HOST) ---
PROXYSQL_BIND=0.0.0.0
PROXYSQL_APP_PORT=6033
MONITOR_USER=monitor
MONITOR_PASSWORD=
MYSQL_SERVER_VERSION=8.0.36
