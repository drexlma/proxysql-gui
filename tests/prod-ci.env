# Werte für tests/prod.sh: die Prod-GUI gegen den laufenden Test-Stack (Demo-Passwörter aus docker-compose.yml)
GUI_PORT=8090
GUI_PASSWORD=ci-prod
GUI_READONLY_PASSWORD=ci-read
GUI_IMAGE_TAG=ci
PROXYSQL_HOST=proxysql
PROXYSQL_PASSWORD=radmin-demo
BACKEND_HOST=mariadb
BACKEND_USER=gui_admin
BACKEND_PASSWORD=gui-demo
# UDP braucht keinen laufenden Empfänger – GitHub-Runner und Docker Desktop haben keinen verlässlichen /dev/log
SYSLOG_ADDRESS=udp://127.0.0.1:514
