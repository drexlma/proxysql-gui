# Test-/Demo-Umgebung (docker-compose.yml) – nach .env kopieren und anpassen.
# Für Produktion: .env.prod.example und docker-compose.prod.yml.
# Passwörter ohne Anführungszeichen, ":" und ";" (Trennzeichen in der ProxySQL-Konfiguration).
# Achtung: ProxySQL und MariaDB übernehmen Passwörter nur beim allerersten Start.
# Danach ändern: docker compose down -v && docker compose up -d   (löscht alle Daten!)

TZ=Europe/Berlin

# Ports auf dem Host
GUI_PORT=8080
PROXYSQL_PORT=6033
PROXYSQL_ADMIN_PORT=6032
MARIADB_PORT=3307

# Login für die GUI (leeres Passwort = ohne Login, dann nur lesend)
GUI_USER=admin
GUI_PASSWORD=admin-demo
GUI_READONLY=0
# Zweites Login nur zum Lesen, ohne SQL-Konsole (leeres Passwort = aus)
GUI_READONLY_USER=readonly
GUI_READONLY_PASSWORD=readonly-demo

# Automatischer Abgleich durch den Sync-Container (leer = nur anzeigen, Übernehmen per Klick):
#   users = fehlende Konten nach ProxySQL übernehmen, passwords = Passwörter aus dem Backend angleichen,
#   cluster = neue Cluster-Knoten aufnehmen. Gelöscht wird nie automatisch.
AUTO_SYNC=
SYNC_INTERVAL=60
# Sync-Container mitstarten:
# COMPOSE_PROFILES=sync

MARIADB_ROOT_PASSWORD=root-demo
REPLICATION_PASSWORD=repl-demo
PROXYSQL_ADMIN_PASSWORD=radmin-demo
MONITOR_PASSWORD=monitor-demo
GUI_BACKEND_PASSWORD=gui-demo
APP_PASSWORD=app-demo
